# =============================================================================
# Naviera Docs — Variables de entorno (copiar a .env si desarrollas SIN Docker)
# En Docker Compose las variables críticas están en docker-compose.yml
# =============================================================================

APP_NAME=naviera-docs
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Base de datos ---
# Local sin Docker (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./data/naviera.db
# DATABASE_URL_SYNC=sqlite:///./data/naviera.db

# Local con PostgreSQL o Docker:
DATABASE_URL=postgresql+asyncpg://naviera:naviera_secret_change_me@localhost:5432/naviera
DATABASE_URL_SYNC=postgresql://naviera:naviera_secret_change_me@localhost:5432/naviera

# --- Rutas ---
INBOX_PATH=./backend/data/inbox
STORAGE_LOCAL_PATH=./backend/storage
USE_CONSOLE_NOTIFIER=true

# --- SMTP (MailHog local) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@naviera.local
SMTP_USE_TLS=false

# URL base para el botón "Aprobar" en el correo (debe ser alcanzable por el cliente)
PUBLIC_API_URL=http://localhost:8000
APPROVAL_TOKEN_SECRET=naviera-dev-approval-secret-change-me
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# --- CORS / Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Naviera Docs
